# Quote form email delivery (set ONE provider)

# Option A: Resend (recommended) — https://resend.com
RESEND_API_KEY=
# Verified sender, e.g. "Infinite Engineering <quotes@infiniteengineeringservices.com>"
QUOTE_FROM_EMAIL=
# Where quote requests are delivered (defaults to site.email in config/site.ts)
QUOTE_TO_EMAIL=

# Option B: Web3Forms (no backend setup) — https://web3forms.com
WEB3FORMS_KEY=
